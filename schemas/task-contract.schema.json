{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daedalus task contract",
  "type": "object",
  "required": [
    "run_id",
    "contract_version",
    "objective",
    "scope",
    "acceptance_criteria",
    "risk_tier",
    "required_checks",
    "budget"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_tier": {
      "type": "string"
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_plan": {
      "type": "string"
    },
    "approval_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "max_attempts",
        "max_wall_seconds",
        "max_cost",
        "max_workers"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1
        },
        "max_cash": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "design_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
